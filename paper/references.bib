@misc{lin2021pretrained,
  title = {Pretrained {{Transformers}} for {{Text Ranking}}: {{BERT}} and {{Beyond}}},
  shorttitle = {Pretrained {{Transformers}} for {{Text Ranking}}},
  author = {Lin, Jimmy and Nogueira, Rodrigo and Yates, Andrew},
