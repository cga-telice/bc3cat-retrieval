@article{moral-andresCanArtificialIntelligence2024,
  title = {Can {{Artificial Intelligence Reconstruct Ancient Mosaics}}?},
  author = {{Moral-Andr{\'e}s}, Fernando and {Merino-G{\'o}mez}, Elena and Reviriego, Pedro and Lombardi, Fabrizio},
  year = {2024},
  month = jul,
  journal = {Studies in Conservation},
  volume = {69},
