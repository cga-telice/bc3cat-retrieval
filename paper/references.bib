  title = {Systems Integration and Collaboration in Architecture, Engineering, Construction, and Facilities Management: {{A}} Review},
  author = {Shen, W. and Hao, Q. and Mak, Helium and Neelamkavil, J. and Xie, Helen and Dickinson, J. and Thomas, Russ and Pardasani, A. and Xue, Henry},
