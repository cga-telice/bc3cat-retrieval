  doi = {10.2749/101686692780615996},
  abstract = {Knowledge-based systems (expert systems) in construction management ought to support decision making based upon technical, technological, and economical criteria. A major decision for each contractor is the choice of construction method and construction equipment for a given project. This choice has to be made in the bidding phase if pricing is to be sufficiently precise. A major earth work project was selected to demonstrate the structure of a knowledge base, the process of bid preparation, and some rules and facts, together with the final outcome. (A)},
  file = {C:\Users\cesar\Zotero\storage\3P6MUKB8\Schub y Elmadlaji - 1992 - A knowledge-based expert system for earthmoving.pdf}
